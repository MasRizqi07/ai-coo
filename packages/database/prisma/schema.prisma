generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  WARKOP
  TOKO_BANGUNAN
  LAUNDRY
  BENGKEL
  RETAIL
  DISTRIBUTOR
  OTHER
}

enum Role {
  OWNER
  STAFF
}

enum InsightType {
  SALES
  INVENTORY
  REVENUE
  DAILY_BRIEF
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  KASBON
}

model Company {
  id           String       @id @default(uuid())
  name         String
  businessType BusinessType
  phone        String?
  address      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users     User[]
  customers Customer[]
  products  Product[]
  sales     Sale[]
  insights  Insight[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

model Customer {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  name           String
  phone          String?
  email          String?
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  lastPurchaseAt DateTime? @map("last_purchase_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("customers")
}

model Product {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  name          String
  sku           String?
  category      String?   @default("Umum")
  price         Decimal   @db.Decimal(12, 2)
  stockQuantity Int       @default(0) @map("stock_quantity")
  minStockLevel Int       @default(10) @map("min_stock_level")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("products")
}

model Sale {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  customerId    String?       @map("customer_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paidAmount    Decimal?      @map("paid_amount") @db.Decimal(12, 2)
  changeAmount  Decimal?      @map("change_amount") @db.Decimal(12, 2)
  notes         String?
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]

  @@index([companyId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String   @map("sale_id")
  productId  String?  @map("product_id") // Null if product is deleted to preserve history
  quantity   Int
  priceAtSale Decimal @map("price_at_sale") @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Insight {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  type        InsightType
  content     Json // The insight payload (AI generated)
  generatedAt DateTime    @default(now()) @map("generated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("insights")
}
