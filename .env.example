# ===========================================
# AI COO — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER prefix server-only secrets with NEXT_PUBLIC_.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicoo?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication ---
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=change-me-also-in-production-min-32-chars
REFRESH_TOKEN_EXPIRATION=7d

# --- AI Provider (server-only, NEVER NEXT_PUBLIC_) ---
OPENAI_API_KEY=sk-your-key-here

# --- Application ---
API_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Observability (server-only) ---
SENTRY_DSN=
LOG_LEVEL=debug
